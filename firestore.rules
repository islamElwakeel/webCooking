rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // أي حد يقرا المنيو، والتعديل لحساب صاحبة المطبخ بس
    match /{col}/{id} {
      // items = الأصناف، settings = رقم الواتساب
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'ADMIN_EMAIL_HERE';
    }
  }
}
